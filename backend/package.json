{
  "name": "@icf/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:local": "tsx watch --env-file-if-exists=.env --env-file=.env.local src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --experimental-test-module-mocks --test 'src/**/*.test.ts'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:migrate:pv-targets": "tsx --env-file-if-exists=.env scripts/migrate-pv-targets.mjs pv-targets.sql vayana_subscription_entity",
    "db:migrate:pv-targets:local": "tsx --env-file-if-exists=.env --env-file=.env.local scripts/migrate-pv-targets.mjs pv-targets.sql vayana_subscription_entity",
    "db:migrate:pv-subscriptions": "tsx --env-file-if-exists=.env scripts/migrate-pv-subscriptions.mjs",
    "db:migrate:pv-subscriptions:commit": "tsx --env-file-if-exists=.env scripts/migrate-pv-subscriptions.mjs --commit",
    "db:migrate:pv-subscriptions:local": "tsx --env-file-if-exists=.env --env-file=.env.local scripts/migrate-pv-subscriptions.mjs",
    "db:migrate:pv-subscriptions:local:commit": "tsx --env-file-if-exists=.env --env-file=.env.local scripts/migrate-pv-subscriptions.mjs --commit"
      },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.4.5",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@types/ssh2": "^1.15.6",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "prisma@7.10.0": true,
    "ssh2@1.17.0": true,
    "@prisma/engines@7.10.0": true,
    "cpu-features@0.0.10": true,
    "esbuild": true
  }
}
