# Copy to .env and fill in real values. .env is gitignored; only this file belongs in Git.

# --- Core ---------------------------------------------------------------------------------
# NODE_ENV=development
# PORT=3000

# DATABASE_URL="mysql://<db-user>:<db-password>@localhost:3306/<db-name>"

# Secret for signing login tokens. Required. At least 32 characters in production, which the app
# checks at startup. Generate one with: openssl rand -hex 32
# JWT_SECRET=

# --- Optional SSH tunnel ------------------------------------------------------------------
# When SSH_HOST is set, DATABASE_URL's host/port is the local end of the tunnel,
# e.g. DATABASE_URL="mysql://<db-user>:<db-password>@127.0.0.1:3307/<db-name>"
# SSH_HOST=your-server-ip
# SSH_PORT=22
# SSH_USER=your-ssh-user
# SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
# SSH_PASSPHRASE=
# SSH_DB_HOST=127.0.0.1
# SSH_DB_PORT=3306

# --- Sessions -----------------------------------------------------------------------------
# How long a login token stays valid, in minutes. Short by design: logging out revokes a token,
# and the denylist only has to remember it until it would expire anyway. Default 15.
# ACCESS_TOKEN_TTL_MINUTES=15

# --- Member photos ------------------------------------------------------------------------
# membership_master.image_url holds only a file name; photos are served from this address.
# Without it, a profile's photo_url is null. e.g. https://example.com/uploads/members
# MEMBER_PHOTO_BASE_URL=

# --- Browser access -----------------------------------------------------------------------
# Origins allowed to call this API, comma separated. Leave empty in development: Vite proxies
# /api to this server, so the browser stays on one origin and no CORS setup is needed.
# Set it for a deployed build where the app is served from somewhere else.
# CORS_ORIGINS=https://portal.example.com

# --- Rate limiting ------------------------------------------------------------------------
# Per-IP limits. The auth endpoints get the tighter one, because each request there is a guess
# at a credential. Per-account lockout is separate and is not configurable here.
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20

# Largest JSON body accepted. This API only takes small objects.
# JSON_BODY_LIMIT=100kb

# Express "trust proxy". Needed behind a load balancer so rate limiting keys on the real client
# IP rather than the proxy's. Empty = off, "true", a number of hops, or e.g. "loopback".
# Leave it off unless something in front of this server strips incoming X-Forwarded-For headers.
# TRUST_PROXY=
