# PORT=3000
# DATABASE_URL="mysql://root:password@localhost:3306/mock_icf_ifrt"

# Optional SSH tunnel. When SSH_HOST is set, DATABASE_URL's host/port is the local end of the tunnel,
# e.g. DATABASE_URL="mysql://user:password@127.0.0.1:3307/dbname"
# SSH_HOST=your-server-ip
# SSH_PORT=22
# SSH_USER=your-ssh-user
# SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
# SSH_PASSPHRASE=
# SSH_DB_HOST=127.0.0.1
# SSH_DB_PORT=3306

# Secret for signing login tokens, e.g. generate with: openssl rand -hex 32
# JWT_SECRET=
